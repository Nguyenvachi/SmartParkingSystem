# ==============================================================
# SmartParkingSystem - VPS Production Example (.env)
# Domain: replace parking.example.com with a domain you control
# HTTPS: Enable via docker compose profile "https" (proxy + certbot)
# ==============================================================

# ---------- Domain / URL ----------
APP_FRONTEND_BASE_URL=https://parking.example.com

# CORS / WebSocket origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=https://parking.example.com
APP_WS_ALLOWED_ORIGIN_PATTERNS=https://parking.example.com

# Security: disable demo password-reset token exposure
APP_PASSWORD_RESET_EXPOSE_TOKEN=false

# Let Spring Boot generate correct https links behind reverse proxy
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ---------- Ports (recommended) ----------
# Only expose reverse proxy publicly
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Bind internal services to localhost on the VPS
# IMPORTANT: If you run `docker compose up` WITHOUT profile `https`, these localhost bindings
# will make the site unreachable from the internet (common symptom: ERR_CONNECTION_REFUSED).
# Recommended flow: run `./scripts/vps/init-letsencrypt.sh` (it uses `--profile https`).
# Optional (after first cert issuance): set this so you don't forget the profile:
# COMPOSE_PROFILES=https
FRONTEND_PORT=127.0.0.1:3000
BACKEND_PORT=127.0.0.1:8080
PHPMYADMIN_PORT=127.0.0.1:8081
MYSQL_PORT=127.0.0.1:3306
MAILPIT_SMTP_PORT=127.0.0.1:1025
MAILPIT_WEB_PORT=127.0.0.1:8025

# ---------- Database (change these!) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG
# This repo's docker-compose uses MySQL `root` user for the backend.
# Keep MYSQL_USERNAME=root unless you also change docker-compose to create/use a non-root app user.
MYSQL_USERNAME=root
# MySQL image only applies initial credentials on FIRST boot (fresh volume).
# If you change MYSQL_ROOT_PASSWORD after the first run, you must reset the DB volume or reset password inside MySQL.
# If you keep using `root` as DB user, make sure this matches MYSQL_ROOT_PASSWORD.
MYSQL_PASSWORD=CHANGE_ME_STRONG

# ---------- App secrets (change these!) ----------
# Generate secrets on VPS: openssl rand -hex 32
APP_JWT_SECRET=CHANGE_ME_32PLUS_CHARS
APP_QR_SECRET=CHANGE_ME_32PLUS_CHARS

# ---------- Google OAuth2 (required if you enable Google login) ----------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ---------- Email (optional) ----------
APP_MAIL_ENABLED=false
# IMPORTANT:
# - If you use Gmail SMTP, set APP_MAIL_FROM to the SAME address as SPRING_MAIL_USERNAME
#   (or configure a verified alias in Gmail). Otherwise Gmail may reject the message.
# - If you set SPRING_MAIL_HOST=mailpit, emails are captured by Mailpit (dev inbox) and
#   will NOT reach real inboxes.
APP_MAIL_FROM=no-reply@parking.example.com
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ---------- Payments (optional) ----------
# Gateways require a public HTTPS backend base URL for callbacks/IPN.
APP_PAYMENT_BACKEND_BASE_URL=https://parking.example.com

# MoMo (set true after you fill all keys)
APP_PAYMENT_MOMO_ENABLED=false
APP_PAYMENT_MOMO_PARTNER_CODE=CHANGE_ME
APP_PAYMENT_MOMO_ACCESS_KEY=CHANGE_ME
APP_PAYMENT_MOMO_SECRET_KEY=CHANGE_ME
APP_PAYMENT_MOMO_ALLOW_UNSAFE_RETURN_SUCCESS=false

# VNPay (set true after you fill all keys)
APP_PAYMENT_VNPAY_ENABLED=false
APP_PAYMENT_VNPAY_TMN_CODE=CHANGE_ME
APP_PAYMENT_VNPAY_HASH_SECRET=CHANGE_ME
