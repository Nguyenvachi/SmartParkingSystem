# Copy this file to application-secrets.properties and fill in your local values.
# This file is ignored by Git and loaded automatically when present.

# Optional local database overrides
db.username.local=root
db.password.local=

# Google OAuth2 local credentials
google.client.id.local=your-google-client-id
google.client.secret.local=your-google-client-secret

# Local app secrets
jwt.secret.local=replace-with-a-32-char-plus-secret
qr.secret.local=replace-with-a-strong-qr-secret